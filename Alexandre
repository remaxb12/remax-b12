<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alexandre Ferreira | REMAX B12</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --wine:#7A1128;
    --red:#E4162C;
    --navy:#0A1B3D;
    --blue:#1656F2;
    --cream:#F5F0E6;
    --ink:#151515;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    font-family:'Poppins', sans-serif;
    background:var(--navy);
    color:var(--ink);
    min-height:100vh;
    display:flex;
    justify-content:center;
  }
  .card{
    width:100%;
    max-width:430px;
    background:var(--cream);
    min-height:100vh;
    position:relative;
    overflow:hidden;
  }

  .hero{
    position:relative;
    background:var(--navy);
    padding:34px 20px 40px;
    text-align:center;
  }
  .hero-brand-row{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:14px;
  }
  .pin-outer{
    width:60px; height:60px;
    flex-shrink:0;
    border-radius:50% 50% 50% 0;
    transform:rotate(-45deg);
    overflow:hidden;
    position:relative;
    border:3px solid var(--cream);
    box-shadow:0 6px 16px rgba(0,0,0,0.4);
  }
  .pin-inner{
    position:absolute;
    inset:0;
    transform:rotate(45deg);
    background:conic-gradient(var(--red) 0 90deg, var(--blue) 90deg 180deg, var(--navy) 180deg 270deg, var(--wine) 270deg 360deg);
  }
  .pin-inner::after{
    content:"";
    position:absolute;
    left:0; right:0; top:42%; height:16%;
    background:var(--cream);
  }
  .brand-name{
    color:var(--cream);
    font-weight:800;
    font-size:22px;
    letter-spacing:1.5px;
  }

  .photo-wrap{
    position:relative;
    display:flex;
    justify-content:center;
    margin-top:-30px;
    z-index:3;
  }
  .photo-wrap img{
    width:150px; height:150px;
    border-radius:50%;
    object-fit:cover;
    border:5px solid var(--cream);
    box-shadow:0 8px 22px rgba(0,0,0,0.35);
    background:#ddd;
  }

  .info{
    text-align:center;
    padding:14px 28px 0;
  }
  .info h1{
    font-size:22px;
    font-weight:700;
    color:var(--navy);
  }
  .info .role{
    margin-top:4px;
    font-size:13.5px;
    font-weight:600;
    color:var(--red);
    letter-spacing:0.5px;
    text-transform:uppercase;
  }
  .info .creci{
    margin-top:6px;
    font-size:13px;
    color:#444;
    font-weight:500;
  }

  .actions{
    margin-top:18px;
    padding:0 24px 28px;
    display:flex;
    flex-direction:column;
    gap:12px;
  }
  .btn{
    display:flex;
    align-items:center;
    gap:14px;
    text-decoration:none;
    padding:11px 16px;
    border-radius:14px;
    font-weight:700;
    font-size:14.5px;
    color:var(--navy);
    background:#ffffff;
    border:1px solid rgba(10,27,61,0.08);
    box-shadow:0 3px 8px rgba(0,0,0,0.06);
    transition:transform .15s ease;
  }
  .btn:active{ transform:scale(0.97); }
  .btn .icon{
    width:38px; height:38px;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-shrink:0;
    box-shadow:0 2px 6px rgba(0,0,0,0.18);
  }
  .btn .icon.squircle{ border-radius:28%; }
  .btn .icon.circle{ border-radius:50%; }
  .btn .icon svg{ width:21px; height:21px; }
  .icon.wa-icon{ background:linear-gradient(135deg,#6bfc9c,#12c95e); }
  .icon.ig-icon{ background:linear-gradient(135deg,#4f5bd5 0%,#962fbf 30%,#d62976 55%,#fa7e1e 80%,#feda75 100%); }
  .icon.site-icon{ background:#1179c9; }
  .icon.phone-icon{ background:#27ae60; }

  footer{
    text-align:center;
    padding:10px 20px 26px;
    font-size:11px;
    color:#777;
  }
  footer b{ color:var(--navy); }
</style>
</head>
